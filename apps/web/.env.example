# 本番ビルド時は絶対URL用オリジンを設定
# SITE_ORIGIN は prerender / sitemap / robots 用
# VITE_SITE_ORIGIN はクライアント setSeo 用（同じ値でよい）
SITE_ORIGIN=https://lottery-analytics.com
VITE_SITE_ORIGIN=https://lottery-analytics.com

# Amazonアフィリエイト
# 基本は public/affiliate-items.json（各商品の "on": true/false で表示切替。画面上の切替UIは無し）
# JSONが空／無いときだけ、下の env を使う
# 短縮URLから画像・価格を取る:
#   node scripts/fetch-amazon-aff.mjs https://link.amazon/xxx https://link.amazon/yyy
# VITE_AMAZON_AFF_ITEMS=[{"url":"https://link.amazon/xxxxxxxx","title":"商品名","image":"https://...","price":"¥1,234"}]
