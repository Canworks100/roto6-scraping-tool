[Unit]
Description=Loto6 latest collect on draw nights (Mon/Thu)

[Timer]
Unit=loto-collect-latest@loto6.service
# 開始 20:50: 公式案内の「20:30すぎ照会可」に合わせた想定（楽天 lastresults の実測時刻ではない）
OnCalendar=Mon,Thu *-*-* 20:50:00
OnCalendar=Mon,Thu *-*-* 21:05:00
OnCalendar=Mon,Thu *-*-* 21:20:00
OnCalendar=Mon,Thu *-*-* 21:35:00
OnCalendar=Mon,Thu *-*-* 21:55:00
OnCalendar=Mon,Thu *-*-* 22:20:00
OnCalendar=Mon,Thu *-*-* 22:50:00
Persistent=true
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
