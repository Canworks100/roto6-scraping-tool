[Unit]
Description=Loto public FastAPI (uvicorn)
After=network.target

[Service]
Type=simple
User=loto
Group=loto
WorkingDirectory=/opt/loto
Environment=PYTHONPATH=/opt/loto/src:/opt/loto/apps/api
ExecStart=/opt/loto/.venv/bin/uvicorn loto_api.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
