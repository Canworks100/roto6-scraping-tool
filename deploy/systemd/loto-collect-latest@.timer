[Unit]
Description=Evening latest-draw collect for %i

[Timer]
# 抽せん会のあと番号を拾い、公式CSVが出てから金額を足す
OnCalendar=*-*-* 18:50:00
OnCalendar=*-*-* 19:10:00
OnCalendar=*-*-* 19:35:00
OnCalendar=*-*-* 20:40:00
OnCalendar=*-*-* 21:30:00
OnCalendar=*-*-* 22:30:00
Persistent=true
RandomizedDelaySec=3m

[Install]
WantedBy=timers.target
