[Unit]
Description=Miniloto latest collect on draw nights (Tue)

[Timer]
Unit=loto-collect-latest@miniloto.service
# 20:15開始、15分おき、最終22:50。掲載時刻は未計測。実行ログの「当日掲載=yes」で記録する。
OnCalendar=Tue *-*-* 20:15:00
OnCalendar=Tue *-*-* 20:30:00
OnCalendar=Tue *-*-* 20:45:00
OnCalendar=Tue *-*-* 21:00:00
OnCalendar=Tue *-*-* 21:15:00
OnCalendar=Tue *-*-* 21:30:00
OnCalendar=Tue *-*-* 21:45:00
OnCalendar=Tue *-*-* 22:00:00
OnCalendar=Tue *-*-* 22:15:00
OnCalendar=Tue *-*-* 22:30:00
OnCalendar=Tue *-*-* 22:45:00
OnCalendar=Tue *-*-* 22:50:00
Persistent=true
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
