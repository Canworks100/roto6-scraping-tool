[Unit]
Description=DISABLED mizuho nightly collect for %i — disable/mask on VPS
# 楽天運用では: systemctl disable --now loto-collect@loto6.timer loto-collect@loto7.timer loto-collect@miniloto.timer

[Timer]
# 誤 enable 時の保険。実害のある収集は service 側で no-op。
OnCalendar=*-*-* 03:17:00
Persistent=false

[Install]
WantedBy=timers.target
